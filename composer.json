{
    "name": "pdf-to-word/converter",
    "description": "PDF to Word Converter with OCR support",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "phpoffice/phpword": "^1.2",
        "phpoffice/math": "^0.1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PDFToWord\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
