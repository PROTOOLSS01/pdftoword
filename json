{
    "name": "pdf-to-word-converter",
    "description": "Convert PDF files to Word (DOCX) format",
    "type": "project",
    "require": {
        "phpoffice/phpword": "^1.0",
        "thiagoalessio/tesseract_ocr": "^2.12",
        "smalot/pdfparser": "^2.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"if (!file_exists('uploads')) { mkdir('uploads', 0755, true); }\"",
            "php -r \"if (!file_exists('outputs')) { mkdir('outputs', 0755, true); }\""
        ]
    }
}
