{
    "name": "pdf-word-converter",
    "description": "Production-ready PDF to Word Converter",
    "type": "project",
    "require": {
        "php": "^8.2",
        "phpoffice/phpword": "^1.2",
        "monolog/monolog": "^3.5",
        "symfony/http-foundation": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/process": "^6.4",
        "vlucas/phpdotenv": "^5.6",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "chmod -R 775 uploads temp logs public"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
