# render.yaml
services:
  - type: web
    name: pdf-to-word-converter
    runtime: docker
    plan: standard
    region: oregon
    dockerfilePath: ./Dockerfile
    buildCommand: ./build.sh
    startCommand: ./start.sh
    envVars:
      - key: APP_ENV
        value: production
      - key: APP_DEBUG
        value: false
      - key: UPLOAD_MAX_SIZE
        value: 100M
      - key: MAX_EXECUTION_TIME
        value: 300
      - key: MEMORY_LIMIT
        value: 512M
      - key: LOG_LEVEL
        value: error
    healthCheckPath: /health
    autoDeploy: true
    disk:
      name: temp-storage
      mountPath: /var/www/html/temp
      sizeGB: 10
    scaling:
      minInstances: 1
      maxInstances: 1
      targetMemoryPercent: 80
